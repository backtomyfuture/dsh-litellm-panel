{
  "name": "dsh-litellm-panel",
  "version": "0.2.6",
  "description": "DeepSeek Harness sidebar panel for LiteLLM models, MCP servers, skills, and spend.",
  "license": "MIT",
  "author": "backtomyfuture",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtomyfuture/dsh-litellm-panel.git"
  },
  "bugs": {
    "url": "https://github.com/backtomyfuture/dsh-litellm-panel/issues"
  },
  "homepage": "https://github.com/backtomyfuture/dsh-litellm-panel#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run lint && node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "litellm"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
